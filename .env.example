# Local mode needs no credentials. CMS mode requires BOTH public values.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_READ_TOKEN=
SANITY_PREVIEW_SECRET=

# Use the actual deployment origin, with no trailing slash.
SITE_URL=http://localhost:3000

# Configure these as production Worker secrets/variables in Cloudflare.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# The production Worker also needs a KV namespace binding named RATELIMIT_KV.

# Google Calendar booking settings. Keep OAuth credentials in .dev.vars locally
# and Cloudflare Worker secrets in production; never commit their values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SETUP_KEY=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
BOOKING_TIME_ZONE=Africa/Nairobi
BOOKING_START_TIME=09:00
BOOKING_END_TIME=17:00
BOOKING_SLOT_MINUTES=30
BOOKING_INTERVAL_MINUTES=30

# Separate Sanity Studio process reads these values.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
