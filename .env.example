# Local mode needs no credentials. CMS mode requires BOTH public values.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_READ_TOKEN=
SANITY_PREVIEW_SECRET=

# Use the actual deployment origin, with no trailing slash.
SITE_URL=http://localhost:3000

# All five values below are required to enable the contact endpoint.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Separate Sanity Studio process reads these values.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
